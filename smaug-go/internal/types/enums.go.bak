	PULL_VACUUM     PullType = 2
	PULL_SLIP       PullType = 3
	PULL_ICE        PullType = 4
	PULL_MYSTERIOUS PullType = 5

	PULL_CURRENT   PullType = PT_WATER
	PULL_WAVE      PullType = PT_WATER + 1
	PULL_WHIRLPOOL PullType = PT_WATER + 2
	PULL_GEYSER    PullType = PT_WATER + 3

	PULL_WIND     PullType = PT_AIR
